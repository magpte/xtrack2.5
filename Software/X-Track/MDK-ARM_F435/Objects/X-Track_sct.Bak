; *************************************************************
; *** Scatter-Loading Description File generated by uVision ***
; *************************************************************

LR_IROM1 0x08000000 0x00100000  {    ; load region size_region
  ER_IROM1 0x08000000 0x00100000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }

  ; SRAM1: 0x20000000 ~ 0x2004FFFF (320 KB)
  ; 放置所有通用 RW/ZI 数据，包括 LVGL 帧缓冲、LVGL pool、ZST2 scratch/chunk buf
  RW_IRAM1 0x20000000 0x00050000  {  ; RW data (SRAM1, 320 KB)
   .ANY (+RW +ZI)
  }

  ; SRAM2: 0x20050000 ~ 0x2005FFFF (64 KB)
  ; 专门放 ZST2 workspace（32 KB），将其与 SRAM1 完全隔离，
  ; 避免 workspace 末地址越过 0x20050000 边界导致 AHB 总线矩阵
  ; EDMA/CPU 仲裁延迟（实测会引起 DIALPLATE / SystemInfos 掉帧）。
  ; ZST2 workspace 仅在 LiveMap 解压 chunk 时被读写，非 LiveMap
  ; 期间零访问，放入 SRAM2 对主路径性能无影响。
  RW_IRAM2 0x20050000 0x00010000  {  ; ZI data (SRAM2, 64 KB)
   *(.sram2_bss)
  }
}

